{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Rome",
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "automerge": false,
  "platformAutomerge": false,
  "rebaseWhen": "conflicted",
  "pre-commit": { "enabled": true },
  "customManagers": [
    {
      "description": "prek pinned in uvx commands.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^\\.pre-commit-config\\.yaml$/",
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": ["uvx --from (?<depName>[a-z0-9-]+)==(?<currentValue>\\d[^\\s`]*)"],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "The harness CLIs pinned in the Harness CLIs workflow, each under a `# renovate: datasource=... depName=...` comment.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/harnesses\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+run: [^\\n]*@(?<currentValue>\\d[^\\s]*)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "A week after any release, not on the dev schedule: a CLI release can change the flags chartroom passes, and the bump's PR runs the Harness CLIs workflow.",
      "matchFileNames": [".github/workflows/harnesses.yaml"],
      "matchDatasources": ["npm"],
      "groupName": "harness CLIs",
      "schedule": ["at any time"]
    },
    {
      "description": "Dev tooling in one weekly PR.",
      "matchFileNames": ["package.json"],
      "groupName": "dev tooling"
    },
    {
      "description": "Actions stay pinned to a commit SHA; Renovate updates the SHA and its version comment.",
      "matchManagers": ["github-actions"],
      "groupName": "actions",
      "commitMessagePrefix": "chore(ci):"
    }
  ]
}
